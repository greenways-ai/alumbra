{
  "name": "@greenways/alumbra-monorepo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@greenways/alumbra-monorepo",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/lab": {
      "name": "@greenways/alumbra-lab",
      "version": "0.1.0",
      "dependencies": {
        "@greenways/alumbra-core": "0.1.0",
        "@greenways/alumbra-renderer-playcanvas": "0.1.0"
      }
    },
    "node_modules/@greenways/alumbra-core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@greenways/alumbra-lab": {
      "resolved": "apps/lab",
      "link": true
    },
    "node_modules/@greenways/alumbra-renderer-playcanvas": {
      "resolved": "packages/renderer-playcanvas",
      "link": true
    },
    "packages/core": {
      "name": "@greenways/alumbra-core",
      "version": "0.1.0"
    },
    "packages/renderer-playcanvas": {
      "name": "@greenways/alumbra-renderer-playcanvas",
      "version": "0.1.0",
      "license": "EPL-2.0",
      "dependencies": {
        "@greenways/alumbra-core": "0.1.0"
      },
      "engines": {
        "node": ">=20"
      },
      "peerDependencies": {
        "playcanvas": "^2.21.0"
      },
      "peerDependenciesMeta": {
        "playcanvas": {
          "optional": true
        }
      }
    }
  }
}
