{
  "name": "@greenways/alumbra-hodos",
  "version": "0.1.0",
  "description": "Trusted Hodos Workspace component and renderer-workspace adapters for Alumbra",
  "type": "module",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenways-ai/alumbra.git",
    "directory": "packages/hodos"
  },
  "exports": {
    ".": "./src/index.js",
    "./model": "./src/model.js",
    "./host": "./src/host.js",
    "./workspace": "./src/renderer-workspace.js",
    "./catalog": "./generated/renderer-catalog.js",
    "./hara/*": "./src/gw/alumbra/*.hal"
  },
  "files": ["src", "generated", "examples", "README.md", "project.edn", "project.lock.edn", "hara.recipe.edn", "showcase.edn", "showcase"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@greenways/hodos-web": "0.1.0",
    "@greenways/hodos-workspace-ui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@greenways/hodos-web": { "optional": true },
    "@greenways/hodos-workspace-ui": { "optional": true }
  },
  "engines": { "node": ">=20" }
}
