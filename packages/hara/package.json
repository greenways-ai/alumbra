{
  "name": "@greenways/alumbra-hara",
  "version": "0.1.0",
  "description": "Portable Hara block packs, generator plans, world extensions and interaction results for Alumbra",
  "type": "module",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenways-ai/alumbra.git",
    "directory": "packages/hara"
  },
  "exports": {
    ".": "./src/index.js",
    "./block-pack": "./src/block-pack.js",
    "./generator": "./src/generator-plan.js",
    "./world": "./src/world-extension.js",
    "./interaction": "./src/interaction.js",
    "./fixtures": "./src/fixtures.js",
    "./runtime": "./src/runtime.js",
    "./hara/*": "./src/gw/alumbra/*.hal"
  },
  "files": [
    "src",
    "README.md",
    "project.edn",
    "project.lock.edn",
    "hara.recipe.edn",
    "showcase.edn",
    "showcase"
  ],
  "sideEffects": false,
  "publishConfig": {"access": "public"},
  "dependencies": {"@greenways/alumbra-core": "0.1.0"},
  "engines": {"node": ">=20"}
