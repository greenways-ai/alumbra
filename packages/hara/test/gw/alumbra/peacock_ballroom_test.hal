(ns gw.alumbra.peacock-ballroom-test
  (:require [std.lib.test :as test]
            [gw.alumbra.peacock-ballroom :as ballroom]))

(def block-pack
  (ballroom/peacock-ballroom-block-pack))

(def generator
  (ballroom/peacock-ballroom-generator))

(def world
  (ballroom/peacock-ballroom-world))

(def provider
  (ballroom/provider-descriptor))

(def coordinates
  (ballroom/chunk-coordinates))

(def center-plan
  (ballroom/peacock-ballroom-chunk-plan generator [0 0 0] [16 16 16]))

(def day-view
  (ballroom/state-view "ballroom/day"))

(def results
  [(test/check
    "the Peacock Ballroom block pack carries the package and palette identity"
    [(get block-pack "format")
     (get block-pack "package")
     (get block-pack "version")
     (get block-pack "id")
     (count (get block-pack "blocks"))]
    ["alumbra.block-pack/1"
     "hara:greenways/alumbra-peacock-ballroom"
     "0.1.0"
     "ballroom/architectural-palette"
     10])

   (test/check
    "the authored world spans one exact forty-eight chunk envelope"
    [(get world "format")
     (get (get world "envelope") "chunkShape")
     (get (get world "envelope") "minimumChunk")
     (get (get world "envelope") "maximumChunk")
     (get (get world "envelope") "chunkCount")
     (count coordinates)
     (first coordinates)
     (last coordinates)]
    ["alumbra.architectural-world/1"
     [16 16 16]
     [-2 0 -2]
     [1 2 1]
     48
     48
     [-2 0 -2]
     [1 2 1]])

   (test/check
    "the Hara generator produces the bounded center architecture plan"
    [(get generator "id")
     (get generator "seed")
     (get center-plan "format")
     (get center-plan "coord")
     (get center-plan "revision")
     (count (get center-plan "regions"))
     (count (get center-plan "overrides"))
     (get (get center-plan "metadata") "authoredBy")]
    ["ballroom/architectural-generator"
     "20260811"
     "alumbra.generated-chunk/1"
     [0 0 0]
     1
     0
     576
     "gw.alumbra.peacock-ballroom"])

   (test/check
    "the architecture contains its floor, chandelier, dome, colonnade and windows"
    [(ballroom/ballroom-block-at -1 1 0)
     (ballroom/ballroom-block-at -1 15 0)
     (ballroom/ballroom-block-at -1 30 0)
     (ballroom/ballroom-block-at -18 15 4)
     (ballroom/ballroom-block-at 25 10 4)
     (ballroom/ballroom-block-at -1 2 23)]
    ["ballroom/brushed-gold"
     "ballroom/amber-lamp"
     "ballroom/brushed-gold"
     "ballroom/brushed-gold"
     "ballroom/emerald-enamel"
     "ballroom/air"])

   (test/check
    "named states, camera views and landmarks remain portable Hara values"
    [(get world "defaultState")
     (get world "states")
     (count (get world "landmarks"))
     (get (first (get world "landmarks")) "id")
     (get day-view "position")
     (get day-view "label")]
    ["ballroom/day"
     ["ballroom/day" "ballroom/gallery-overlook" "ballroom/mosaic-floor"]
     6
     "ballroom/main-hall"
     [-0.5 2.05 23.5]
     "Day entrance"])

   (test/check
    "the Hodos handoff contains semantic identities only"
    [(get provider "provider/id")
     (get provider "provider/activity")
     (get provider "provider/package")
     (get provider "provider/default-state")
     (get provider "provider/states")]
    ["alumbra/world"
     "alumbra-hara/peacock-ballroom"
     "hara:greenways/alumbra-peacock-ballroom@0.1.0"
     "ballroom/day"
     ["ballroom/day" "ballroom/gallery-overlook" "ballroom/mosaic-floor"]])])

(test/print-results results)
