{
  "name": "@greenways/alumbra-history",
  "version": "0.1.0",
  "description": "Storage-neutral region history, checkpoints and transaction replay for Alumbra",
  "type": "module",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenways-ai/alumbra.git",
    "directory": "packages/history"
  },
  "exports": {
    ".": "./src/index.js",
    "./digest": "./src/digest.js",
    "./region": "./src/region.js",
    "./checkpoint": "./src/checkpoint.js",
    "./session": "./src/session.js",
    "./hara/*": "./src/gw/alumbra/*.hal"
  },
  "files": [
    "src",
    "README.md",
    "project.edn",
    "project.lock.edn",
    "hara.recipe.edn",
    "showcase.edn",
    "showcase"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@greenways/alumbra-core": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
