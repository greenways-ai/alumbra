{
  "name": "@greenways/alumbra-history-store",
  "version": "0.1.0",
  "description": "Content-addressed archive storage for verified Alumbra world history",
  "type": "module",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenways-ai/alumbra.git",
    "directory": "packages/history-store"
  },
  "exports": {
    ".": "./src/index.js",
    "./bytes": "./src/bytes.js",
    "./store": "./src/store.js",
    "./archive": "./src/archive.js",
    "./hara/*": "./src/gw/alumbra/*.hal"
  },
  "files": [
    "src",
    "README.md",
    "project.edn",
    "project.lock.edn",
    "hara.recipe.edn",
    "showcase.edn",
    "showcase"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@greenways/alumbra-core": "0.1.0",
    "@greenways/alumbra-history": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
