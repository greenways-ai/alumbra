  },
  "dependencies": {
    "@greenways/alumbra-core": "0.1.0"
  },
  "peerDependencies": {
    "playcanvas": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "playcanvas": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
