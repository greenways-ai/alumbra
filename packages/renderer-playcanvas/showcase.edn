{:hara/type :showcase
 :showcase/format 1
 :showcase/package :greenways/alumbra-renderer-playcanvas
 :showcase/version "0.1.0"
 :showcase/title "PlayCanvas Renderer"
 :showcase/summary
 "Voxel meshing, material and environment profiles, picking and bounded dynamic residency projected from canonical Alumbra chunks."

 :showcase/views
 [{:view/id :greedy-meshing
   :view/title "Greedy meshing"
   :view/summary "Compare a canonical voxel fixture with bounded quad and material-group evidence."}
  {:view/id :chunk-residency
   :view/title "Dynamic chunk residency"
   :view/summary "Drive a bounded residency window across chunk boundaries and inspect count-only scheduling evidence."}
  {:view/id :stale-mesh-rejection
   :view/title "Stale mesh rejection"
   :view/summary "Complete mesh jobs out of revision order and prove only the current canonical revision installs."}
  {:view/id :material-matrix
   :view/title "Material matrix"
   :view/summary "Render opaque, cutout, transparent, emissive and selection-overlay profiles together with bounded resource evidence."}
  {:view/id :environment-profile
   :view/title "Environment profiles"
   :view/summary "Switch among daylight, fog and emissive-night environments and reject an unknown installed profile."}]

 :showcase/states
 [{:state/id :mesh/single-chunk
   :state/title "Single meshed chunk"
   :state/summary "A bounded render-evidence fixture for one canonical chunk revision."
   :state/file "showcase/states/greedy-meshing.edn"}
  {:state/id :residency/cross-boundary
   :state/title "Cross a chunk boundary"
   :state/summary "A count-only residency transition that requests new chunks and evicts resources behind the player."
   :state/file "showcase/states/chunk-residency.edn"}
  {:state/id :residency/stale-mesh
   :state/title "Reject a stale mesh"
   :state/summary "Revision two installs while the later completion for revision one is discarded."
   :state/file "showcase/states/stale-mesh-rejection.edn"}
  {:state/id :materials/daylight
   :state/title "Daylight material matrix"
   :state/summary "Five installed material passes under the daylight environment profile."
   :state/file "showcase/states/material-daylight.edn"}
  {:state/id :materials/fog
   :state/title "Fog environment"
   :state/summary "The same installed materials under the bounded linear-fog environment."
   :state/file "showcase/states/material-fog.edn"}
  {:state/id :materials/emissive
   :state/title "Emissive night"
   :state/summary "The emissive material pass under the installed low-light environment."
   :state/file "showcase/states/material-emissive.edn"}
  {:state/id :materials/unknown-profile-error
   :state/title "Unknown profile rejection"
   :state/summary "An uninstalled material profile fails before any PlayCanvas resource is allocated."
   :state/file "showcase/states/material-unknown-profile-error.edn"}]

