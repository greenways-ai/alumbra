(ns gw.alumbra.core)

(def chunk-format "alumbra.chunk/1")
(def snapshot-format "alumbra.chunk-snapshot/1")
(def transaction-format "alumbra.block-transaction/1")
(def default-chunk-shape [32 32 32])

(defn generator-identity [package version id seed]
  {"package" package
   "version" version
   "id" id
   "seed" seed})
