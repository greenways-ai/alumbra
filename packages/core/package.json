{
  "name": "@greenways/alumbra-core",
  "version": "0.1.0",
  "description": "Runtime-neutral blocks, chunks, snapshots and transactions for Alumbra",
  "type": "module",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenways-ai/alumbra.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": "./src/index.js",
    "./blocks": "./src/block-registry.js",
    "./coordinates": "./src/coordinates.js",
    "./chunks": "./src/chunk.js",
    "./snapshots": "./src/snapshot.js",
    "./transactions": "./src/transaction.js",
    "./generator": "./src/generator.js",
    "./hara/*": "./src/gw/alumbra/*.hal"
  },
  "files": [
    "src",
    "README.md",
    "project.edn",
    "project.lock.edn",
    "hara.recipe.edn",
    "showcase.edn",
    "showcase"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
