{
  "name": "@greenways/alumbra-viewport-playcanvas",
  "version": "0.1.0",
  "description": "Lifecycle-owned PlayCanvas viewport sessions for Alumbra worlds",
  "type": "module",
  "license": "EPL-2.0",
  "repository": {
