(ns showcase.alumbra-viewport-playcanvas.lit-world
  (:require [gw.alumbra.viewport :as viewport]))

(def lighting
  (viewport/lighting-descriptor))

(def session
  (viewport/session "lit-world/1" "world:alumbra/lit-cave"))

(def states
  [{:state/id :lighting/live
    :state/lamp :present
    :state/boundary-emission 14}
   {:state/id :lighting/lamp-removed
    :state/transaction "lit-world/remove-boundary-lamp"
    :state/lamp :removed
    :state/boundary-emission 0}
   {:state/id :lighting/lamp-restored
    :state/transaction "lit-world/restore-boundary-lamp"
    :state/lamp :present
    :state/boundary-emission 14}
   {:state/id :lighting/stale-generation-rejected
    :state/fence :coordinator-request-version
    :state/final-authority :newest-canonical-revision}
   {:state/id :world/edit-roof-open
    :state/path :ordinary-player-controller
    :state/edit :break
    :state/sunlight :increased}
   {:state/id :world/edit-lamp-place
    :state/path :ordinary-player-controller
    :state/edit :place
    :state/emitted :increased}
   {:state/id :world/edit-lamp-remove
    :state/path :ordinary-player-controller
    :state/edit :break
    :state/emitted :baseline-restored}
   {:state/id :world/edit-stale-rebuild-rejected
    :state/path :ordinary-player-controller
    :state/fence :coordinator-request-version
    :state/final-authority :newest-canonical-revision}])

{:story/id :viewport/lit-world
 :story/activity "alumbra-viewport-playcanvas/lit-world"
 :story/session (viewport/resume (viewport/suspend session))
 :story/states states
 :story/fixture
 {:chunks ["-1,0,0" "0,0,0"]
  :boundary-lamp {:chunk "-1,0,0"
                  :local [15 2 4]
                  :adjacent-chunk "0,0,0"
                  :adjacent-local [0 2 4]}}
 :story/lighting lighting
 :story/authority
 {:edits :engine-player-controller
  :transactions :core
  :fields :engine
  :meshes :renderer
  :orchestration :viewport}
 :story/excludes
 [:chunks :dense-light-fields :mesh-buffers :callbacks
  :playcanvas-objects :capabilities :project-paths]}
