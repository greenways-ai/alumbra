{:hara/type :showcase
 :showcase/format 1
 :showcase/package :greenways/alumbra-viewport-playcanvas
 :showcase/version "0.1.0"
 :showcase/title "PlayCanvas Viewport"
 :showcase/summary
 "Lifecycle-owned viewport sessions that compose canonical worlds, players, input and revision-fenced PlayCanvas lighting projection."

 :showcase/views
 [{:view/id :playable-world
   :view/title "Playable packaged world"
   :view/summary "Run one canonical world through a reusable viewport session with explicit suspend, resume and disposal."}
  {:view/id :two-sessions
   :view/title "Two independent sessions"
   :view/summary "Run two viewport sessions without sharing world state, player clocks or renderer resources."}
  {:view/id :lit-world
   :view/title "Live lit-world viewport"
   :view/summary "Project a negative-to-zero two-chunk cave through Engine lighting, renderer mesh sidecars and PlayCanvas vertex colours."}]

 :showcase/states
 [{:state/id :viewport/playable-world
   :state/title "Playable world"
   :state/summary "One active session retaining the same canonical world across visibility changes."
   :state/file "showcase/states/playable-world.edn"}
  {:state/id :viewport/two-sessions
   :state/title "Two sessions"
   :state/summary "Two separately owned worlds and lifecycle counters projected together."
   :state/file "showcase/states/two-sessions.edn"}
  {:state/id :lighting/live
   :state/title "Live boundary lamp"
   :state/summary "The current canonical lamp revision emits across the negative-to-zero chunk boundary."
   :state/file "showcase/states/lit-world-live.edn"}
  {:state/id :lighting/lamp-removed
   :state/title "Boundary lamp removed"
   :state/summary "A revision-checked Core transaction removes the lamp and darkens only the bounded affected projections."
   :state/file "showcase/states/lit-world-lamp-removed.edn"}
  {:state/id :lighting/lamp-restored
   :state/title "Boundary lamp restored"
   :state/summary "The accepted inverse transaction restores the lamp and current cross-boundary lighting."
   :state/file "showcase/states/lit-world-lamp-restored.edn"}
  {:state/id :lighting/stale-generation-rejected
   :state/title "Stale lighting generation rejected"
   :state/summary "An obsolete delayed generation loses to the newer restored canonical revision."
   :state/file "showcase/states/lit-world-stale-generation.edn"}
  {:state/id :world/edit-roof-open
   :state/title "Ordinary roof break admits sunlight"
   :state/summary "The player controller breaks one revision-checked roof block and incrementally lights the shaft."
   :state/file "showcase/states/lit-world-edit-roof-open.edn"}
  {:state/id :world/edit-lamp-place
   :state/title "Ordinary lamp placement emits"
   :state/summary "The player controller places one negative-coordinate lamp and reprojects only the bounded affected chunks."
   :state/file "showcase/states/lit-world-edit-lamp-place.edn"}
  {:state/id :world/edit-lamp-remove
   :state/title "Ordinary lamp removal clears"
   :state/summary "The player controller removes the placed lamp and restores the prior emitted-light baseline."
   :state/file "showcase/states/lit-world-edit-lamp-remove.edn"}
  {:state/id :world/edit-stale-rebuild-rejected
   :state/title "Stale ordinary rebuild rejected"
   :state/summary "An older delayed lamp-placement rebuild cannot replace the newer canonical removal."
   :state/file "showcase/states/lit-world-edit-stale-rebuild.edn"}]

