(ns gw.alumbra.viewport)

(def lighting-coordinator-format "alumbra.viewport-lighting-coordinator/1")
(def lighting-evidence-format "alumbra.viewport-lighting-evidence/1")
(def lit-session-format "alumbra.lit-viewport-session/1")

(defn session [id world-id]
  {:viewport/session id
   :viewport/world world-id
   :viewport/status :active
   :viewport/frame 0
   :viewport/suspensions 0
   :viewport/resumes 0})

(defn suspend [value]
  (assoc value
         :viewport/status :suspended
         :viewport/suspensions (+ 1 (:viewport/suspensions value))))

(defn resume [value]
  (assoc value
         :viewport/status :active
         :viewport/resumes (+ 1 (:viewport/resumes value))))

(defn dispose [value]
  (assoc value :viewport/status :disposed))

(defn lighting-descriptor []
  {:viewport/lighting-coordinator lighting-coordinator-format
   :viewport/lighting-evidence lighting-evidence-format
   :viewport/lit-session lit-session-format
   :viewport/authority :orchestration
   :viewport/canonical-authority :core
   :viewport/field-authority :engine
   :viewport/mesh-authority :renderer
   :viewport/publication :revision-fenced})
